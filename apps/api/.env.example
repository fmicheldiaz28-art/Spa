NODE_ENV=development
PORT=4000

# PostgreSQL local (pnpm db:start) o Docker (infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://naturalspa:naturalspa@localhost:5432/naturalspa
DATABASE_POOL_MAX=10
# Con PGlite (pnpm db:start:lite) usa en su lugar:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
# DATABASE_POOL_MAX=1

# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-desarrollo

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_HOURS=8
WEB_ORIGIN=http://localhost:3000

# Email. Sin SMTP_URL, en desarrollo los correos se muestran en el log del API.
# Con Docker (Mailpit): SMTP_URL=smtp://localhost:1025  → bandeja en http://localhost:8025
# SMTP_URL=
MAIL_FROM=NaturalSpa <no-responder@naturalspa.bo>

# Recordatorios automáticos a las clientas (24 h y 2 h antes). 0 los apaga en esta instancia.
REMINDERS_INTERVAL_SEC=60

# Crea colaboradoras y datos de ejemplo al ejecutar el seed (solo local/staging)
SEED_DEMO=true
